# Required in production
NODE_ENV=production
DATABASE_URL=postgres://user:password@host:5432/dbname   # any Postgres (Supabase, Neon, Kuberns database)
SESSION_SECRET=                                          # random string, 32+ chars (openssl rand -hex 32)
RESEND_API_KEY=                                          # sends the login codes and invite emails
MAIL_FROM="Marketing Crew <login@yourdomain.com>"        # must be a verified sender domain in Resend

# Optional
PUBLIC_URL=https://your-app-domain.com                   # used for links in invite emails
APP_NAME=Marketing Crew
PORT=3000
PG_POOL_MAX=10
